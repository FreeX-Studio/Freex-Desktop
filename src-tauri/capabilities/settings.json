{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "The app's own settings window (ui/settings.html): what is set for this PC \u2013 TV mode, start at login, player, server \u2013 and quitting.",
  "local": true,
  "windows": [
    "settings"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "allow-servers-list",
    "allow-desktop-info",
    "allow-set-player",
    "allow-set-auto-connect",
    "allow-show-servers",
    "allow-tv-enter",
    "allow-tv-leave",
    "allow-autostart-get",
    "allow-autostart-set",
    "allow-app-quit"
  ]
}
